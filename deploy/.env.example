# ===== Clelia & Co. platform — copy to deploy/.env and fill in =====
DOMAIN=design.cleliaandco.com
ACME_EMAIL=admin@cleliaandco.com

# Database password (letters and numbers only is simplest). Generate: openssl rand -hex 16
DB_PASSWORD=

# Signs sessions and encrypts AI keys. Generate: openssl rand -base64 48
# NEVER change after go-live, or stored AI keys become unreadable.
APP_SECRET=

# First admin login, created on the very first start only
ADMIN_EMAIL=admin@cleliaandco.com
ADMIN_PASSWORD=
ADMIN_NAME=Studio Admin

# Razorpay — Dashboard → Account & Settings → API keys. Start with test keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://DOMAIN/api/payments/razorpay/webhook with events
# payment.captured, payment.failed, refund.processed; paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=

AI_IMAGES_PER_IP_PER_DAY=30
