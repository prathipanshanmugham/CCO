# --- Clelia & Co. API ---
NODE_ENV=production
PORT=4000
# PostgreSQL connection
DATABASE_URL=postgresql://clelia:change-me@db:5432/clelia?schema=public
# 32+ random chars. Signs sessions AND encrypts AI keys. Never change after go-live
# (changing it invalidates stored AI keys). Generate: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used in links and CORS)
PUBLIC_URL=https://design.cleliaandco.com
# Where uploads, AI images and 3D files are stored (volume in Docker)
STORAGE_DIR=./storage
# Razorpay (Dashboard → Settings → API keys). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# First admin account, created on first start if no users exist
ADMIN_EMAIL=admin@cleliaandco.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Studio Admin
# Daily AI image cap per customer IP (abuse control)
AI_IMAGES_PER_IP_PER_DAY=30
